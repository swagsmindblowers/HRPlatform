# The URL of your LaunchHR deployment, no trailing slash.
LAUNCHHR_BASE_URL=https://your-launchhr-domain.example.com

# A personal access token, created from Settings > API tokens inside LaunchHR.
# Actions run as whichever employee owns this token.
LAUNCHHR_API_TOKEN=

# The id of the company to act within (visible in any LaunchHR URL, e.g.
# the "4" in https://your-domain/4/dashboard).
LAUNCHHR_COMPANY_ID=
